{
  "name": "yt-music-tauri",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "powershell -NoProfile -File scripts/build-windows.ps1",
    "build:unsigned": "tauri build",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "npm run test:js && npm run test:rust",
    "test:js": "node --test tests/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "verify:windows": "powershell -NoProfile -File scripts/verify-windows-bundle.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
