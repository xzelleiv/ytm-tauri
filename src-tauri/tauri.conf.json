{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "YouTube Music",
  "version": "0.2.5",
  "identifier": "app.ytmusic.desktop",
  "build": {
    "frontendDist": "../src",
    "devUrl": "https://music.youtube.com"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "xzelleiv",
    "copyright": "Copyright © 2026 xzelleiv. Original work by Henix.",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "wix/app-identity.wxs"
        ],
        "componentGroupRefs": [
          "AppUserModelIdentityComponents"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDRDA5QzYwMzFCQTRDNUEKUldSYVRMb3hZSnpRL0g0UEI3b1Iybm9aSXVqbUxWQkpjZVdqQVZCSmwzUlhaUCtuRGczTFd6N3cK",
      "endpoints": [
        "https://github.com/xzelleiv/ytm-tauri/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
